# Local Convex or hosted Convex deployment URL (browser-safe)
VITE_CONVEX_URL=
SITE_URL=https://pizzadude123.github.io/oakridge-ops/

# Legacy sender fallback retained for existing workspace seed data.
VITE_GMAIL_SENDER=nagapranayimmadi@gmail.com

# Server-only Microsoft Graph OAuth settings for delegated Mail.Read, Mail.Send,
# Files.Read, User.Read, and offline_access.
# Configure these in Convex,
# never as VITE_ browser variables and never commit real values.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_GRAPH_REDIRECT_URI=https://first-echidna-899.convex.site/graph/callback
# Shared server-side OAuth-token encryption key; never expose this to Vite.
GRAPH_TOKEN_ENCRYPTION_KEY=

# Optional comma-separated EB accounts. These users can authenticate only into
# Delegate Experience and publish chair explainers/crisis updates; operations,
# contacts, email, inbox, Forms, and workbook data remain administrator-only.
OAKRIDGE_EB_PUBLISHER_EMAILS=

# Server-only Google OAuth Web client for Email Studio.
# Register exactly: https://first-echidna-899.convex.site/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=https://first-echidna-899.convex.site/google/callback
